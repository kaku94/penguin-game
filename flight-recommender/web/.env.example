# 로컬 개발: 이 파일을 .env.local 로 복사해서 값을 채운다. Vercel에서는 프로젝트 환경변수로 설정.
ANTHROPIC_API_KEY=

# Supabase 프로젝트 설정 > API. 서버에서만 쓰는 키라 NEXT_PUBLIC_ 을 붙이지 않는다.
# (Vercel의 Supabase 연동을 쓰면 자동으로 들어온다)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 선택: 기본값은 lib/config.ts 참고
# PARSE_MODEL=claude-opus-5-5
# SEARCH_MODEL=claude-opus-5-5
# MONTHLY_BUDGET_USD=7
